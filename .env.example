NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Jakarta
MONGODB_URI=mongodb://localhost:27017/spi_compliance
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
NVIDIA_API_KEY=
NVIDIA_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NVIDIA_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_REQUEST_TIMEOUT_MS=240000
NVIDIA_DISPOSITION_REVIEW_TIMEOUT_MS=240000
NVIDIA_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=2048
NVIDIA_RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
NVIDIA_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
NVIDIA_RERANK_TIMEOUT_MS=90000
MONGODB_VECTOR_COLLECTION=document_chunk_vectors
MONGODB_VECTOR_INDEX_NAME=spi_chunks_vector_idx
# Optional aliases matching the supplied client configuration; secret stays blank.
CHAT_AI_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
CHAT_AI_API_KEY=
CHAT_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CHAT_AI_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
CHAT_AI_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
CHUNKING_API_BASE_URL=
CHUNKING_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_OFFSETS=24h,1h
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_REVIEW_EVIDENCE_PAGES=40
MAX_REVIEW_TEXT_CHARS=50000
NVIDIA_OCR_MAX_IMAGE_BYTES=130000
DOCUMENT_CHUNK_MAX_WORDS=450
DOCUMENT_CHUNK_OVERLAP_WORDS=70
MAX_REVIEW_TEXT_CHARS=40000
